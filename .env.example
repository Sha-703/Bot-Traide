# =========================================================================
#  Pocket Lab - configuration type
#  Copiez ce fichier vers `.env` :   copy .env.example .env
#  .env est ignore par git et ne doit JAMAIS etre commite.
# =========================================================================

#  Mode d'execution (obligatoire)
MODE_REEL=False

#  Identifiants de session : laisses en memoire. Ne pas commiter.
SSID=

#  Endpoint WebSocket (mode Observation). Point de depart a adapter.
# WS_URL=wss://api-eu.po.market/socket.io/?EIO=4&transport=websocket

#  Double confirmation reel. Le simple True ne suffit pas.
# CONFIRMATION_REELLE=JE CONFIRME LE RISQUE REEL

# --- Marche -------------------------------------------------------------
ACTIF=EURUSD
DUREE_EXPIRATION_S=60
PAYOUT=0.87

# --- MT5 (Weltrade, compte DEMO) ----------------------------------------
# Lecture seule par defaut : ticks + solde reel du compte demo.
# MT5_DEMO=true           -> lit le compte demo (ticks + solde reel)
# MT5_EXE=true            -> envoie des ordres REELS sur le compte demo
# Le compte reel est bloque - jamais d'execution reelle.
# Le terminal Weltrade MT5 doit etre installe, DEMARRE et connecte.
#MT5_DEMO=true
#MT5_EXE=true
#MT5_SYMBOLE=EURUSD_i
#MT5_CHEMIN_TERMINAL=C:\Program Files\Weltrade MT5 Terminal\terminal64.exe
#MT5_VOLUME=0.01
#MT5_SL_POINTS=50
#MT5_TP_POINTS=100

# --- Strategie ----------------------------------------------------------
# ema       = croisement EMA 9/21 (historique)
# bollinger = retour a la moyenne sur bougies M1 (validee sur MT5 Weltrade)
#STRATEGIE=bollinger
STRATEGIE=ema

# --- Flux de prix -------------------------------------------------------
# simule  = generateur interne (aucun reseau)
# binance = prix publics Binance (lecture seule)
FLUX_PRIX=simule
ACTIF_BINANCE=BTCUSDT

# --- Capital et sizing ---------------------------------------------------
CAPITAL_INITIAL=10
MONTANT_TRADE=1
TAILLE_MAX_POSITION=5
FRACTION_RISQUE_PAR_TRADE=0.01

# --- Garde-fous de risque ------------------------------------------------
PERTE_MAX_JOURNALIERE=30
TRADES_MAX_PAR_JOUR=20
COOLDOWN_SIGNAL_S=30

# --- Strategie (ema) ------------------------------------------------------
EMA_RAPIDE=9
EMA_LENTE=21
SEUIL_ECART_BPS=1.0
INTERVALLE_TICK_S=1.0

# --- Console web ---------------------------------------------------------
HOTE_DASHBOARD=127.0.0.1
PORT_DASHBOARD=8080

# --- Simulation -----------------------------------------------------------
FACTEUR_VITESSE=1
# Graine fixe = reproductible. Vide = aleatoire.
GRAINE_ALEATOIRE=
