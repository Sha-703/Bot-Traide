# =========================================================================
#  Pocket Lab — modèle de configuration
#  Copiez ce fichier vers `.env` :   copy .env.example .env
#  Le fichier `.env` est ignoré par git et ne doit JAMAIS être commité.
# =========================================================================

# --- Mode d'exécution (OBLIGATOIRE, sans valeur par défaut) ---------------
# Le bot refuse de démarrer si cette variable est absente.
# False = simulation papier (aucun ordre réel, aucun SSID requis).
MODE_REEL=False

# --- Identifiants de session ---------------------------------------------
# Rien n'est obligatoire ici : la console propose un panneau « Connexion »
# où le SSID reste EN MÉMOIRE (jamais écrit sur disque).
# Ce champ sert de valeur de départ si vous préférez le charger au démarrage.
# Jeton extrait de votre navigateur (DevTools > Réseau > WS > messages).
# À traiter comme un mot de passe : durée de vie courte, révocable.
SSID=

# Endpoint WebSocket utilisé par le mode Observation / le test de connexion.
# Pocket Option ne publie pas son protocole : cette valeur est un point de
# départ, à adapter à votre propre capture réseau.
# WS_URL=wss://api-eu.po.market/socket.io/?EIO=4&transport=websocket

# Double confirmation exigée pour le réel (texte exact, sinon refus).
# CONFIRMATION_REELLE=JE CONFIRME LE RISQUE REEL

# --- Marché ---------------------------------------------------------------
ACTIF=EURUSD
DUREE_EXPIRATION_S=60
PAYOUT=0.87

# --- Flux de prix ---------------------------------------------------------
# simule  = générateur interne, aucun réseau (défaut)
# binance = prix réels publics Binance, LECTURE SEULE, ordres papier
# Indépendant du mode d'exécution : vous pouvez mesurer la stratégie sur de
# vrais prix sans compte, sans clé et sans risque.
FLUX_PRIX=simule
ACTIF_BINANCE=BTCUSDT

# --- Capital et sizing ----------------------------------------------------
CAPITAL_INITIAL=10
MONTANT_TRADE=1
TAILLE_MAX_POSITION=5
FRACTION_RISQUE_PAR_TRADE=0.01

# --- Garde-fous de risque -------------------------------------------------
PERTE_MAX_JOURNALIERE=30
TRADES_MAX_PAR_JOUR=20
COOLDOWN_SIGNAL_S=30

# --- Stratégie ------------------------------------------------------------
EMA_RAPIDE=9
EMA_LENTE=21
SEUIL_ECART_BPS=1.0
INTERVALLE_TICK_S=1.0

# --- Console web ----------------------------------------------------------
HOTE_DASHBOARD=127.0.0.1
PORT_DASHBOARD=8080

# --- Réseau (optionnel) ---------------------------------------------------
# Si votre opérateur bloque pocketoption.com, indiquez un proxy local pour la
# fenêtre de connexion supervisée, ex. http://127.0.0.1:8080 ou socks5://127.0.0.1:1080
# (vide = accès direct). N'accepte que l'adresse du proxy, aucun identifiant.
PROXY_NAVIGATEUR=

# --- Simulation -----------------------------------------------------------
# 1 = temps réel. >= 50 = horloge virtuelle (campagnes de test instantanées).
FACTEUR_VITESSE=1
# Graine fixe = résultats reproductibles. Vide = aléatoire.
GRAINE_ALEATOIRE=
